---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BlogPreview from '../components/BlogPreview.astro';

// One source for the link bar, rendered under the masthead and again in the
// footer so a reader reaches the links without scrolling either direction.
const contactLinks = [
  { label: 'hi@saxon.zone', href: 'mailto:hi@saxon.zone' },
  { label: 'GitHub', href: 'https://github.com/saxonthune' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/saxonthune' },
];

---
<Base title="Computation">
  <h1 class="font-heading text-5xl font-bold mb-3 tracking-tight text-center dark:text-dark-heading">Computation</h1>
  <p class="text-center text-sm text-black dark:text-dark-muted mb-8 italic">Software Design, and Machine Software</p>

  <nav class="flex items-center justify-center flex-wrap gap-x-2 gap-y-1 mb-12 text-sm" aria-label="Contact">
    {contactLinks.map((link, i) => (
      <>
        {i > 0 && <span class="text-black dark:text-dark-muted">&middot;</span>}
        <a href={link.href} class="text-accent-light dark:text-accent-dark hover:underline">{link.label}</a>
      </>
    ))}
    <span class="text-black dark:text-dark-muted">&middot;</span>
    <ThemeToggle />
  </nav>

  <section aria-labelledby="blog-heading" class="mb-12">
    <h2 id="blog-heading" class="font-heading text-2xl font-bold mb-6 dark:text-dark-heading">From the Blog</h2>
    <BlogPreview />
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-800" />

  <nav class="flex items-center justify-center flex-wrap gap-x-2 gap-y-1 text-sm" aria-label="Contact">
    {contactLinks.map((link, i) => (
      <>
        {i > 0 && <span class="text-black dark:text-dark-muted">&middot;</span>}
        <a href={link.href} class="text-accent-light dark:text-accent-dark hover:underline">{link.label}</a>
      </>
    ))}
    <span class="text-black dark:text-dark-muted">&middot;</span>
    <ThemeToggle />
  </nav>
</Base>
