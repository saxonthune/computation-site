---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const slugFor = (entry: (typeof posts)[number]) => {
  const date = entry.data.date;
  const year = String(date.getUTCFullYear()).slice(2);
  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
  const day = String(date.getUTCDate()).padStart(2, '0');
  return `${year}${month}${day}-${entry.id.replace(/\.mdoc$/, '')}`;
};

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
---
<div>
  <ul class="space-y-4">
    {posts.map((post) => (
      <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <a href={`/blog/${slugFor(post)}`} class="text-accent-light dark:text-accent-dark hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
          {post.data.title}
        </a>
        <time class="shrink-0 text-sm text-black/70 dark:text-dark-muted" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
      </li>
    ))}
  </ul>

  <a href="/blog" class="mt-6 inline-flex items-center gap-2 text-sm text-accent-light dark:text-accent-dark hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
    See all posts <span aria-hidden="true">&rarr;</span>
  </a>
</div>
